LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-api-key-here
SCREEN_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.6-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=your-email@gmail.com

# Local dashboard (keep 127.0.0.1 unless it is behind auth + TLS)
JOBHUNT_WEB_HOST=127.0.0.1
JOBHUNT_WEB_PORT=8000

# Required on Vercel: provision Neon Postgres and use its pooled DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# First administrator. These are used only when the user table is empty.
JOBHUNT_ADMIN_NAME=Administrator
JOBHUNT_ADMIN_EMAIL=admin@example.com
JOBHUNT_ADMIN_PASSWORD=replace-with-at-least-10-characters

# Alternative first-run setup: omit JOBHUNT_ADMIN_PASSWORD and enter this
# token in the setup screen. Remove it after the first admin is created.
JOBHUNT_SETUP_TOKEN=replace-with-a-long-random-token
